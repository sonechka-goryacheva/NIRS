[
  {"name": "Статус репозитория", "command": "git status", "description": "Показывает состояние рабочей директории и индекса.", "examples": ["git status", "git status -s", "git status --short --branch"], "tags": ["git", "status", "репозиторий", "состояние"], "platform": "cross"},
  {"name": "Добавить файлы в индекс", "command": "git add <file>", "description": "Добавляет изменения в индекс перед коммитом.", "examples": ["git add file.txt", "git add .", "git add -p"], "tags": ["git", "add", "индекс", "добавить"], "platform": "cross"},
  {"name": "Создать коммит", "command": "git commit -m \"<message>\"", "description": "Создаёт коммит с сообщением.", "examples": ["git commit -m \"fix bug\"", "git commit --amend", "git commit -am \"update\""], "tags": ["git", "commit", "коммит", "сохранить"], "platform": "cross"},
  {"name": "История коммитов", "command": "git log", "description": "Показывает историю коммитов.", "examples": ["git log", "git log --oneline -10", "git log --graph --all"], "tags": ["git", "log", "история", "коммиты"], "platform": "cross"},
  {"name": "Разница изменений", "command": "git diff", "description": "Показывает различия между версиями файлов.", "examples": ["git diff", "git diff --staged", "git diff HEAD~1"], "tags": ["git", "diff", "разница", "изменения"], "platform": "cross"},
  {"name": "Список веток", "command": "git branch", "description": "Показывает и управляет ветками.", "examples": ["git branch", "git branch -a", "git branch -d <branch>"], "tags": ["git", "branch", "ветки", "список"], "platform": "cross"},
  {"name": "Переключить ветку", "command": "git checkout <branch>", "description": "Переключает ветку или восстанавливает файлы.", "examples": ["git checkout main", "git checkout -b new-feature", "git checkout HEAD -- file.txt"], "tags": ["git", "checkout", "переключить", "ветка"], "platform": "cross"},
  {"name": "Слияние веток", "command": "git merge <branch>", "description": "Сливает указанную ветку в текущую.", "examples": ["git merge feature", "git merge --no-ff feature", "git merge --abort"], "tags": ["git", "merge", "слияние", "ветка"], "platform": "cross"},
  {"name": "Rebase", "command": "git rebase <branch>", "description": "Переносит коммиты на другую базу.", "examples": ["git rebase main", "git rebase -i HEAD~3", "git rebase --abort"], "tags": ["git", "rebase", "перенос", "история"], "platform": "cross"},
  {"name": "Cherry-pick", "command": "git cherry-pick <commit>", "description": "Применяет конкретный коммит к текущей ветке.", "examples": ["git cherry-pick abc123", "git cherry-pick a..b", "git cherry-pick -n abc123"], "tags": ["git", "cherry-pick", "коммит", "перенос"], "platform": "cross"},
  {"name": "Stash", "command": "git stash", "description": "Временно сохраняет изменения.", "examples": ["git stash", "git stash pop", "git stash list"], "tags": ["git", "stash", "сохранить", "временно"], "platform": "cross"},
  {"name": "Сброс изменений", "command": "git reset <mode> <commit>", "description": "Сбрасывает состояние репозитория.", "examples": ["git reset --soft HEAD~1", "git reset --hard HEAD", "git reset file.txt"], "tags": ["git", "reset", "сброс", "откат"], "platform": "cross"},
  {"name": "Откат коммита", "command": "git revert <commit>", "description": "Создаёт новый коммит, отменяющий указанный.", "examples": ["git revert abc123", "git revert HEAD", "git revert -n abc123"], "tags": ["git", "revert", "откат", "отмена"], "platform": "cross"},
  {"name": "Удалённые репозитории", "command": "git remote", "description": "Управляет удалёнными репозиториями.", "examples": ["git remote -v", "git remote add origin <url>", "git remote remove origin"], "tags": ["git", "remote", "удалённый", "репозиторий"], "platform": "cross"},
  {"name": "Fetch", "command": "git fetch", "description": "Загружает изменения без слияния.", "examples": ["git fetch", "git fetch --all", "git fetch origin main"], "tags": ["git", "fetch", "загрузить", "обновления"], "platform": "cross"},
  {"name": "Pull", "command": "git pull", "description": "Загружает и сливает изменения.", "examples": ["git pull", "git pull --rebase", "git pull origin main"], "tags": ["git", "pull", "загрузить", "слить"], "platform": "cross"},
  {"name": "Push", "command": "git push", "description": "Отправляет коммиты в удалённый репозиторий.", "examples": ["git push", "git push -u origin main", "git push --force-with-lease"], "tags": ["git", "push", "отправить", "коммиты"], "platform": "cross"},
  {"name": "Теги", "command": "git tag <name>", "description": "Создаёт и управляет тегами.", "examples": ["git tag v1.0", "git tag -a v1.0 -m \"release\"", "git push --tags"], "tags": ["git", "tag", "тег", "версия"], "platform": "cross"},
  {"name": "Blame", "command": "git blame <file>", "description": "Показывает, кто и когда менял строки файла.", "examples": ["git blame file.txt", "git blame -L 10,20 file.txt", "git blame -w file.txt"], "tags": ["git", "blame", "автор", "строки"], "platform": "cross"},
  {"name": "Bisect", "command": "git bisect", "description": "Бинарный поиск коммита с багом.", "examples": ["git bisect start", "git bisect good abc123", "git bisect bad def456"], "tags": ["git", "bisect", "поиск", "баг"], "platform": "cross"},
  {"name": "Reflog", "command": "git reflog", "description": "Показывает историю перемещений HEAD.", "examples": ["git reflog", "git reflog show main", "git reset --hard HEAD@{2}"], "tags": ["git", "reflog", "история", "head"], "platform": "cross"},
  {"name": "Конфигурация Git", "command": "git config", "description": "Показывает и меняет настройки Git.", "examples": ["git config --list", "git config --global user.name \"Name\"", "git config --global alias.st status"], "tags": ["git", "config", "настройки", "конфиг"], "platform": "cross"}
]

[
  {"name": "Запуск контейнера", "command": "docker run <image>", "description": "Запускает контейнер из образа.", "examples": ["docker run -d -p 8080:80 nginx", "docker run -it ubuntu bash", "docker run --rm -v $(pwd):/app python:3.11"], "tags": ["docker", "run", "контейнер", "запуск"], "platform": "cross"},
  {"name": "Список контейнеров", "command": "docker ps", "description": "Показывает запущенные контейнеры.", "examples": ["docker ps", "docker ps -a", "docker ps -q"], "tags": ["docker", "ps", "контейнеры", "список"], "platform": "cross"},
  {"name": "Список образов", "command": "docker images", "description": "Показывает локальные образы.", "examples": ["docker images", "docker images -a", "docker images --filter \"dangling=true\""], "tags": ["docker", "images", "образы", "список"], "platform": "cross"},
  {"name": "Сборка образа", "command": "docker build -t <name> .", "description": "Собирает образ из Dockerfile.", "examples": ["docker build -t myapp .", "docker build -t myapp:v1 -f Dockerfile.prod .", "docker build --no-cache -t myapp ."], "tags": ["docker", "build", "сборка", "образ"], "platform": "cross"},
  {"name": "Войти в контейнер", "command": "docker exec -it <container> bash", "description": "Запускает команду внутри контейнера.", "examples": ["docker exec -it myapp bash", "docker exec myapp ls /app", "docker exec -u root -it myapp sh"], "tags": ["docker", "exec", "контейнер", "войти"], "platform": "cross"},
  {"name": "Логи контейнера", "command": "docker logs <container>", "description": "Показывает логи контейнера.", "examples": ["docker logs myapp", "docker logs -f myapp", "docker logs --tail 100 myapp"], "tags": ["docker", "logs", "логи", "контейнер"], "platform": "cross"},
  {"name": "Остановка контейнера", "command": "docker stop <container>", "description": "Останавливает контейнер.", "examples": ["docker stop myapp", "docker start myapp", "docker restart myapp"], "tags": ["docker", "stop", "остановить", "контейнер"], "platform": "cross"},
  {"name": "Удаление контейнера", "command": "docker rm <container>", "description": "Удаляет контейнер.", "examples": ["docker rm myapp", "docker rmi myimage", "docker rm -f $(docker ps -aq)"], "tags": ["docker", "rm", "удалить", "контейнер"], "platform": "cross"},
  {"name": "Docker Compose запуск", "command": "docker compose up", "description": "Запускает сервисы из docker-compose.yml.", "examples": ["docker compose up -d", "docker compose up --build", "docker compose -f prod.yml up -d"], "tags": ["docker", "compose", "запуск", "сервисы"], "platform": "cross"},
  {"name": "Docker Compose остановка", "command": "docker compose down", "description": "Останавливает и удаляет сервисы.", "examples": ["docker compose down", "docker compose down -v", "docker compose down --rmi all"], "tags": ["docker", "compose", "остановка", "down"], "platform": "cross"},
  {"name": "Сети Docker", "command": "docker network", "description": "Управляет сетями Docker.", "examples": ["docker network ls", "docker network create mynet", "docker network inspect bridge"], "tags": ["docker", "network", "сети", "сеть"], "platform": "cross"},
  {"name": "Тома Docker", "command": "docker volume", "description": "Управляет томами Docker.", "examples": ["docker volume ls", "docker volume create mydata", "docker volume rm mydata"], "tags": ["docker", "volume", "тома", "данные"], "platform": "cross"},
  {"name": "Очистка Docker", "command": "docker system prune", "description": "Удаляет неиспользуемые данные.", "examples": ["docker system prune", "docker system prune -a", "docker system prune -a --volumes"], "tags": ["docker", "prune", "очистка", "мусор"], "platform": "cross"},
  {"name": "Информация о контейнере", "command": "docker inspect <container>", "description": "Показывает детали контейнера.", "examples": ["docker inspect myapp", "docker inspect --format '{{.State.Status}}' myapp", "docker inspect myimage"], "tags": ["docker", "inspect", "информация", "контейнер"], "platform": "cross"},
  {"name": "Pull и Push образов", "command": "docker pull / docker push", "description": "Загружает и отправляет образы.", "examples": ["docker pull nginx", "docker push myimage", "docker tag myimage:v1 registry/myimage:v1"], "tags": ["docker", "pull", "push", "образ"], "platform": "cross"}
]

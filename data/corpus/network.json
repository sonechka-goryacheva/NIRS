  {"name": "Nmap", "command": "nmap <host>", "description": "Сканирует порты и сервисы.", "examples": ["nmap 192.168.1.1", "nmap -p 1-1000 <host>", "nmap -sV <host>"], "tags": ["network", "nmap", "скан", "порты"], "platform": "cross"},
  {"name": "IP-адреса", "command": "ip a", "description": "Показывает IP-адреса интерфейсов.", "examples": ["ip a", "ip -br a", "ifconfig"], "tags": ["network", "ip", "адрес", "интерфейс"], "platform": "cross"},

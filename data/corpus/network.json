  {"name": "Whois", "command": "whois <domain>", "description": "Информация о домене.", "examples": ["whois google.com", "whois 8.8.8.8", "whois example.com | grep -i \"name server\""], "tags": ["network", "whois", "домен", "информация"], "platform": "cross"}

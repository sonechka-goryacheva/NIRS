[
  {"name": "Ping", "command": "ping <host>", "description": "Проверяет доступность хоста.", "examples": ["ping google.com", "ping -c 4 8.8.8.8", "ping -i 0.5 <host>"], "tags": ["network", "ping", "проверка", "доступность"], "platform": "cross"},

  {"name": "SS", "command": "ss <flags>", "description": "Современная замена netstat.", "examples": ["ss -tuln", "ss -tunp", "ss -tlnp"], "tags": ["network", "ss", "соединения", "порты"], "platform": "cross"},
  {"name": "Lsof", "command": "lsof -i :<port>", "description": "Показывает, какой процесс слушает порт.", "examples": ["lsof -i :8080", "lsof -i -P -n", "lsof -i TCP:80"], "tags": ["network", "lsof", "порт", "процесс"], "platform": "cross"},

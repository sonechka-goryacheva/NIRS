[
  {"name": "Список процессов", "command": "Get-Process", "description": "Показывает запущенные процессы.", "examples": ["Get-Process", "Get-Process -Name chrome", "Get-Process | Sort-Object CPU -Descending | Select-Object -First 10"], "tags": ["powershell", "process", "процессы", "список"], "platform": "windows"},
  {"name": "Остановить процесс", "command": "Stop-Process -Name <name>", "description": "Завершает процесс по имени.", "examples": ["Stop-Process -Name chrome", "Stop-Process -Id 1234", "Stop-Process -Name notepad -Force"], "tags": ["powershell", "stop", "остановить", "процесс"], "platform": "windows"},
  {"name": "Список служб", "command": "Get-Service", "description": "Показывает службы Windows.", "examples": ["Get-Service", "Get-Service -Name spooler", "Get-Service | Where-Object {$_.Status -eq \"Running\"}"], "tags": ["powershell", "service", "службы", "список"], "platform": "windows"},
  {"name": "Управление службой", "command": "Start-Service / Stop-Service / Restart-Service", "description": "Запускает, останавливает, перезапускает службу.", "examples": ["Start-Service -Name spooler", "Stop-Service -Name spooler", "Restart-Service -Name spooler"], "tags": ["powershell", "service", "служба", "управление"], "platform": "windows"},
  {"name": "Список файлов", "command": "Get-ChildItem", "description": "Показывает содержимое папки.", "examples": ["Get-ChildItem", "Get-ChildItem -Recurse -Filter *.log", "Get-ChildItem -Force"], "tags": ["powershell", "files", "файлы", "список"], "platform": "windows"},
  {"name": "Создать файл или папку", "command": "New-Item", "description": "Создаёт файл или папку.", "examples": ["New-Item -ItemType File -Name file.txt", "New-Item -ItemType Directory -Name newfolder", "New-Item -ItemType Directory -Path C:\\Temp\\New"], "tags": ["powershell", "create", "создать", "файл"], "platform": "windows"},
  {"name": "Удалить файл или папку", "command": "Remove-Item", "description": "Удаляет файл или папку.", "examples": ["Remove-Item file.txt", "Remove-Item -Recurse -Force folder", "Remove-Item *.tmp"], "tags": ["powershell", "remove", "удалить", "файл"], "platform": "windows"},
  {"name": "Копировать и переместить", "command": "Copy-Item / Move-Item", "description": "Копирует и перемещает файлы.", "examples": ["Copy-Item src.txt dst.txt", "Move-Item src.txt dst.txt", "Copy-Item -Recurse src/ dst/"], "tags": ["powershell", "copy", "move", "копировать"], "platform": "windows"},
  {"name": "Чтение файла", "command": "Get-Content <file>", "description": "Читает содержимое файла.", "examples": ["Get-Content file.txt", "Get-Content file.txt -Tail 20", "Get-Content file.txt -Wait"], "tags": ["powershell", "content", "читать", "файл"], "platform": "windows"},
  {"name": "Запись в файл", "command": "Set-Content / Add-Content", "description": "Записывает или добавляет текст в файл.", "examples": ["Set-Content file.txt \"text\"", "Add-Content file.txt \"text\"", "Set-Content -Path file.txt -Value \"hello\""], "tags": ["powershell", "write", "записать", "файл"], "platform": "windows"},
  {"name": "Поиск в файлах", "command": "Select-String -Pattern <p> -Path <path>", "description": "Ищет текст в файлах.", "examples": ["Select-String -Pattern \"error\" -Path *.log", "Select-String -Pattern \"todo\" -Path src\\*", "Select-String -Pattern \"fail\" -Path *.txt"], "tags": ["powershell", "search", "поиск", "текст"], "platform": "windows"},
  {"name": "Справка", "command": "Get-Help <cmd>", "description": "Показывает справку по команде.", "examples": ["Get-Help Get-Process", "Get-Help Get-Process -Examples", "Get-Command"], "tags": ["powershell", "help", "справка", "помощь"], "platform": "windows"},
  {"name": "Логи событий", "command": "Get-EventLog / Get-WinEvent", "description": "Читает журналы событий Windows.", "examples": ["Get-EventLog -LogName Application -Newest 20", "Get-WinEvent -LogName System -MaxEvents 20", "Get-EventLog -LogName System -Newest 10"], "tags": ["powershell", "eventlog", "логи", "события"], "platform": "windows"},
  {"name": "Информация о системе", "command": "Get-ComputerInfo", "description": "Показывает сведения о системе.", "examples": ["Get-ComputerInfo", "Get-Volume", "Get-Disk"], "tags": ["powershell", "system", "система", "информация"], "platform": "windows"},

[
  {"name": "Открыть файл или папку в Finder", "command": "open <path>", "description": "Открывает файл или папку в Finder.", "examples": ["open .", "open -a \"Visual Studio Code\" .", "open -R file.txt"], "tags": ["open", "finder", "mac", "gui", "открыть", "файл", "папка"], "platform": "mac"},
  {"name": "Буфер обмена macOS", "command": "pbcopy / pbpaste", "description": "Работа с буфером обмена.", "examples": ["cat file.txt | pbcopy", "pbpaste > file.txt", "history | tail -20 | pbcopy"], "tags": ["clipboard", "copy", "paste", "mac", "буфер", "pbcopy", "pbpaste"], "platform": "mac"},
  {"name": "Озвучивание текста", "command": "say <text>", "description": "Озвучивает текст через динамики Mac.", "examples": ["say \"Готово\"", "say -v Milena \"Сборка завершена\"", "say -r 200 \"текст\""], "tags": ["speak", "voice", "audio", "mac", "озвучить", "голос", "say"], "platform": "mac"},
  {"name": "Управление дисками", "command": "diskutil <action>", "description": "Управляет дисками macOS.", "examples": ["diskutil list", "diskutil info /", "diskutil unmount /Volumes/USB"], "tags": ["disk", "mount", "volume", "mac", "диск", "diskutil"], "platform": "mac"},
  {"name": "Пакетный менеджер Homebrew", "command": "brew <action>", "description": "Управляет пакетами macOS.", "examples": ["brew install wget", "brew update && brew upgrade", "brew services start postgresql"], "tags": ["brew", "package", "install", "mac", "пакеты", "homebrew"], "platform": "mac"},
  {"name": "Настройки macOS через defaults", "command": "defaults <read|write|delete> <domain> <key>", "description": "Читает и меняет настройки macOS.", "examples": ["defaults read com.apple.finder", "defaults write com.apple.finder AppleShowAllFiles -bool true", "defaults delete com.apple.dock"], "tags": ["defaults", "settings", "config", "mac", "настройки", "defaults"], "platform": "mac"},
  {"name": "Поиск через Spotlight", "command": "mdfind <query>", "description": "Поиск файлов через Spotlight.", "examples": ["mdfind \"kind:pdf\"", "mdfind -name \"report\"", "mdfind \"kMDItemFSName == '*.py'\""], "tags": ["search", "spotlight", "find", "files", "mac", "поиск", "mdfind"], "platform": "mac"},
  {"name": "Скриншоты из терминала", "command": "screencapture <file>", "description": "Делает скриншоты.", "examples": ["screencapture screen.png", "screencapture -i crop.png", "screencapture -c"], "tags": ["screenshot", "capture", "screen", "mac", "скриншот", "screencapture"], "platform": "mac"},
  {"name": "Не давать Mac уснуть", "command": "caffeinate <flags>", "description": "Блокирует переход в сон.", "examples": ["caffeinate -i", "caffeinate -t 3600", "caffeinate -dimsu"], "tags": ["sleep", "prevent", "power", "mac", "сон", "caffeinate"], "platform": "mac"},
  {"name": "Настройка сети", "command": "networksetup <action>", "description": "Настраивает сеть macOS.", "examples": ["networksetup -listallnetworkservices", "networksetup -getinfo Wi-Fi", "sudo networksetup -setdnsservers Wi-Fi 1.1.1.1"], "tags": ["network", "dns", "wifi", "settings", "mac", "сеть", "networksetup"], "platform": "mac"},
  {"name": "Управление службами launchd", "command": "launchctl <action>", "description": "Управляет службами macOS.", "examples": ["launchctl list", "launchctl load ~/Library/LaunchAgents/my.plist", "launchctl start my.service"], "tags": ["service", "launchd", "daemon", "mac", "служба", "launchctl"], "platform": "mac"},
  {"name": "Xcode CLI Tools", "command": "xcode-select <action>", "description": "Управляет инструментами Xcode.", "examples": ["xcode-select -p", "xcode-select --install", "sudo xcode-select -s /Applications/Xcode.app"], "tags": ["xcode", "developer", "tools", "mac", "инструменты", "xcode-select"], "platform": "mac"},
  {"name": "Обновления системы", "command": "softwareupdate <flags>", "description": "Управляет обновлениями macOS.", "examples": ["softwareupdate -l", "sudo softwareupdate -i -a", "softwareupdate --history"], "tags": ["update", "system", "mac", "обновление", "softwareupdate"], "platform": "mac"},
  {"name": "Информация о системе", "command": "system_profiler <datatype>", "description": "Показывает информацию о системе.", "examples": ["system_profiler SPHardwareDataType", "system_profiler SPSoftwareDataType", "system_profiler SPStorageDataType"], "tags": ["system", "info", "hardware", "mac", "система", "system_profiler"], "platform": "mac"},
  {"name": "Версия macOS", "command": "sw_vers", "description": "Показывает версию macOS.", "examples": ["sw_vers", "sw_vers -productVersion", "sw_vers -buildVersion"], "tags": ["version", "macos", "system", "mac", "версия", "sw_vers"], "platform": "mac"}
